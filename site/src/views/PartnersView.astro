---
// 合作伙伴页：告诉大家推广 AnyModelBot 能获得持续佣金，并收集申请。佣金比例、价格和结算规则不写，一对一谈。
// 版式和首页同一种语言：首屏大圆角卡 → 三步 → 适合谁 → 为什么好推广 → 申请。章节头用 SectionHead，样式在 pages.css 的“合作伙伴”。
// 申请表的交互在 scripts/partner-form.ts：配了 PARTNER_APPLY_URL 才直接提交，没配时让申请人把内容发到邮箱。
// 机器人不绑定任何一类合作方：只在地平线上探头、主持章节、送通知，以及代表“可以自定义”。
import Base from "../layouts/Base.astro";
import BotFace from "../components/BotFace.astro";
import Icon from "../components/Icon.astro";
import SectionHead from "../components/SectionHead.astro";
import VendorLogo from "../components/VendorLogo.astro";
import VendorSprite from "../components/VendorSprite.astro";
import { buildVars, dict, fmt, href, type Lang } from "../i18n";
import { GLINT, bannerSky } from "../lib/banner-sky";
import { CHAR_KEYS } from "../lib/bots";
import { PARTNER_LIMITS, PARTNER_TYPES, type MailText } from "../lib/partner-form";
import { PARTNERS_EMAIL, PARTNER_APPLY_URL, pricing } from "../lib/site";
import { vendorLogo } from "../lib/vendors";
import "../styles/pages.css";
interface Props { lang: Lang }
const { lang } = Astro.props;
const t = dict(lang);
const p = t.partners;
const a = p.apply;
const vars = buildVars(lang);
const sky = bannerSky();
const whoIcons = ["monitor", "chat", "server"] as const;
// 模型数最多的几家，有标志的才放
const count = (vd: string) => pricing.rows.filter((r) => r.vendor === vd).length;
const vendors = pricing.vendors.filter((vd) => vendorLogo(vd)).map((vd, i) => ({ vd, n: count(vd), i })).sort((x, y) => y.n - x.n || x.i - y.i).map((x) => x.vd).slice(0, 9);
const [dataItem, keyItem, botsItem] = p.why.items;
const inputs = [
  { name: "name", label: a.name, error: a.errors.name, autocomplete: "name" },
  { name: "company", label: a.company, autocomplete: "organization" },
  { name: "contact", label: a.contact, hint: a.contactHint, error: a.errors.contact, wide: true },
  { name: "audience", label: a.audience, hint: a.audienceHint, autocomplete: "off", wide: true },
] as const;
const mailText: MailText = {
  subject: a.mail.subject,
  labels: { type: a.type, name: a.name, company: a.company, contact: a.contact, audience: a.audience, message: a.message },
  types: a.types,
};
---
<Base lang={lang} path="/partners" title={p.pageTitle} description={p.pageDescription}>
  <VendorSprite vendors={vendors} color />
  <div class="container page pt-page">
    <header class="pt-hero">
      <div class="pt-hero__sky" aria-hidden="true">
        <svg viewBox="0 0 1200 360" preserveAspectRatio="xMidYMin slice" focusable="false">
          <g class="dot">{sky.dots.map((s) => <circle cx={s.x} cy={s.y} r={s.r} opacity={s.o} />)}</g>
          <g class="glint">{sky.glints.map((g) => <path d={GLINT} transform={`translate(${g.x} ${g.y}) scale(${g.s})`} opacity={g.o} />)}</g>
        </svg>
      </div>

      <div class="pt-hero__copy">
        <p class="badge badge--accent">{p.eyebrow}</p>
        <h1><span>{p.h1}</span> <mark class="hl">{p.h1Hl}</mark></h1>
        <p class="lead">{p.lead}</p>
        <div class="pt-hero__cta">
          <a class="btn btn--primary" href="#apply" data-track="cta_click" data-track-location="partners-hero">{p.cta}</a>
          <a class="btn btn--secondary" href={href(lang, "/")} data-track="cta_click" data-track-location="partners-product">{p.ctaProduct}</a>
        </div>
        <ul class="pt-hero__points" role="list">
          {p.points.map((x) => <li><Icon name="check" />{x}</li>)}
        </ul>
      </div>

      <figure class="pt-feed">
        <ol role="list">
          <li class="pt-feed__item" style="--i:0"><BotFace char={CHAR_KEYS[0]} size={40} lively /><span>{p.feed.items[0]}</span></li>
          <li class="pt-feed__item" style="--i:1"><BotFace char={CHAR_KEYS[1]} size={40} lively /><span>{p.feed.items[1]}</span></li>
          <li class="pt-feed__item pt-feed__item--earn" style="--i:2"><span class="pt-feed__coin"><Icon name="check" /></span><span>{p.feed.items[2]}</span></li>
        </ol>
        <figcaption>{p.feed.note}</figcaption>
      </figure>

      <div class="pt-hero__bots" aria-hidden="true">{CHAR_KEYS.map((k) => <BotFace char={k} size={72} lively pokeable />)}</div>
      <div class="pt-hero__horizon" aria-hidden="true"></div>
    </header>

    <section class="pt-sec" aria-labelledby="pt-steps-h">
      <SectionHead n={1} label={p.kicker.path} id="pt-steps-h" title={p.steps.title} dim={p.steps.dim} host="blue" />
      <ol class="pt-path" role="list">
        {p.steps.items.map((x, i) => (
          <li>
            <span class="pt-path__no" aria-hidden="true">{String(i + 1).padStart(2, "0")}</span>
            <h3 class="h3">{x.title}</h3>
            <p class="pt-body">{x.body}</p>
          </li>
        ))}
      </ol>
      <a class="btn btn--primary pt-path__cta" href="#apply" data-track="cta_click" data-track-location="partners-steps">{p.cta}</a>
    </section>

    <section class="pt-sec" aria-labelledby="pt-who-h">
      <SectionHead n={2} label={p.kicker.who} id="pt-who-h" title={p.who.title} dim={p.who.dim} host="yellow" />
      <ul class="pt-who" role="list">
        {p.who.items.map((x, i) => (
          <li class="card pt-who__card">
            <span class="dl-ico"><Icon name={whoIcons[i]} size={22} /></span>
            <h3 class="h3">{x.title}</h3>
            <p class="pt-body">{x.body}</p>
            <p class="pt-who__gain"><Icon name="arrow" />{x.gain}</p>
          </li>
        ))}
      </ul>
    </section>

    <section class="pt-sec" aria-labelledby="pt-why-h">
      <SectionHead n={3} label={p.kicker.why} id="pt-why-h" title={p.why.title} dim={p.why.dim} />
      <div class="pt-bento">
        <article class="card pt-bento__card pt-bento__card--models">
          <div>
            <h3 class="h3">{keyItem.title}</h3>
            <p class="pt-body">{fmt(keyItem.body, vars)}</p>
          </div>
          <ul class="pt-tiles" role="list" aria-hidden="true">
            {vendors.map((vd) => <li class="pt-tile"><VendorLogo vendor={vd} size={26} /></li>)}
          </ul>
        </article>
        <article class="card pt-bento__card pt-bento__card--data">
          <div>
            <h3 class="h3">{dataItem.title}</h3>
            <p class="pt-body">{dataItem.body} <a href={href(lang, "/security")}>{p.why.dataLink}</a></p>
          </div>
          <ul class="pt-stays" role="list">
            {p.why.stays.map((x) => <li><Icon name="lock" />{x}</li>)}
          </ul>
        </article>
        <article class="card pt-bento__card pt-bento__card--bots">
          <div>
            <h3 class="h3">{botsItem.title}</h3>
            <p class="pt-body">{botsItem.body}</p>
          </div>
          <div class="pt-bots" aria-hidden="true">{CHAR_KEYS.map((k) => <BotFace char={k} size={64} lively pokeable />)}</div>
        </article>
      </div>
    </section>

    <section class="pt-sec" id="apply" aria-labelledby="pt-apply-h" data-partner-apply>
      <SectionHead n={4} label={p.kicker.apply} id="pt-apply-h" title={a.title} dim={a.dim} host="purple" />
      <div class="pt-apply">
        <div class="pt-apply__intro">
          <p class="lead">{a.lead}</p>
          <ul class="pt-apply__points" role="list">
            {a.points.map((x) => <li><Icon name="check" />{x}</li>)}
          </ul>
          <div class="pt-apply__mail">
            <p>{a.mailLabel}</p>
            <p class="pt-mail">
              <a href={`mailto:${PARTNERS_EMAIL}?subject=${encodeURIComponent(a.mail.subject)}`} data-track="cta_click" data-track-location="partners-email">{PARTNERS_EMAIL}</a>
              <button type="button" class="copy-btn" data-copy-text={PARTNERS_EMAIL} aria-label={t.ui.copy} title={t.ui.copy}><Icon name="copy" /></button>
            </p>
          </div>
        </div>

        <div>
          <form class="card pt-form" data-partner-form data-endpoint={PARTNER_APPLY_URL || undefined} data-email={PARTNERS_EMAIL} data-lang={lang} data-mail={JSON.stringify(mailText)} novalidate>
            <fieldset class="pt-field pt-field--wide" data-field="type">
              <legend class="pt-label">{a.type}</legend>
              <div class="pt-chips">
                {PARTNER_TYPES.map((k) => <label class="pt-chip"><input type="radio" name="type" value={k} aria-describedby="pt-err-type" /><span>{a.types[k]}</span></label>)}
              </div>
              <p class="pt-err" id="pt-err-type" hidden>{a.errors.type}</p>
            </fieldset>

            {inputs.map((f) => {
              const error = "error" in f ? f.error : undefined;
              return (
                <div class:list={["pt-field", { "pt-field--wide": "wide" in f }]} data-field={f.name}>
                  <label class="pt-label" for={`pt-${f.name}`}>{f.label}{!error && <span class="pt-opt">{a.optional}</span>}</label>
                  <input class="pt-input" id={`pt-${f.name}`} name={f.name} type="text" maxlength={PARTNER_LIMITS[f.name]} autocomplete={"autocomplete" in f ? f.autocomplete : undefined} placeholder={"hint" in f ? f.hint : undefined} aria-required={error ? "true" : undefined} aria-describedby={error ? `pt-err-${f.name}` : undefined} />
                  {error && <p class="pt-err" id={`pt-err-${f.name}`} hidden>{error}</p>}
                </div>
              );
            })}

            <div class="pt-field pt-field--wide">
              <label class="pt-label" for="pt-message">{a.message}<span class="pt-opt">{a.optional}</span></label>
              <textarea class="pt-input pt-input--area" id="pt-message" name="message" rows="4" maxlength={PARTNER_LIMITS.message} placeholder={a.messageHint}></textarea>
            </div>

            {/* 蜜罐：正常人看不到，机器人会填 */}
            <div class="pt-hp" aria-hidden="true"><label>Website <input type="text" name="website" tabindex="-1" autocomplete="off" /></label></div>

            <p class="pt-failed" data-partner-failed role="alert" hidden>{fmt(a.failed, { email: PARTNERS_EMAIL })}</p>
            <div class="pt-form__foot">
              <button class="btn btn--primary" type="submit" data-label={a.submit} data-sending={a.sending}>{a.submit}</button>
              <p>{a.consent} <a href={href(lang, "/privacy")}>{a.privacy}</a></p>
            </div>
          </form>

          <div class="card pt-panel" data-partner-done hidden>
            <span class="dl-ico"><Icon name="check" size={22} /></span>
            <h3 class="h3" tabindex="-1" data-partner-focus>{a.done.title}</h3>
            <p class="pt-body">{a.done.body}</p>
          </div>

          <div class="card pt-panel" data-partner-mail hidden>
            <h3 class="h3" tabindex="-1" data-partner-focus>{a.mail.title}</h3>
            <p class="pt-body">{fmt(a.mail.body, { email: PARTNERS_EMAIL })}</p>
            <div class="code"><code></code><button type="button" class="copy-btn" data-copy-code aria-label={t.ui.copy} title={t.ui.copy}><Icon name="copy" /></button></div>
            <div class="pt-panel__actions">
              <a class="btn btn--primary" href="#apply" data-partner-open>{a.mail.open}</a>
              <button class="btn btn--secondary" type="button" data-partner-back>{a.mail.back}</button>
            </div>
          </div>
        </div>
      </div>
    </section>
  </div>
  <script>
    import "../scripts/partner-form";
  </script>
</Base>
